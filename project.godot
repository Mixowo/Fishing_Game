;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FishingFish"
config/description="Este es un juegazo muy duro, que duro, esta el zama."
run/main_scene="uid://c4kqi6t4okoys"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/image="uid://drvyuv5dxtcn"
config/icon="uid://brxmvhryoh8df"

[autoload]

GestoMundo="*uid://bgmug8lognmon"

[display]

window/size/viewport_width=640
window/size/viewport_height=320
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="ignore"
window/vsync/vsync_mode=0

[editor]

movie_writer/fps=120

[editor_plugins]

enabled=PackedStringArray("res://addons/proton_scatter/plugin.cfg")

[filesystem]

import/blender/enabled=false

